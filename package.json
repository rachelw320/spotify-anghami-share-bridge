{
	"name": "spotify-anghami-share-bridge",
	"version": "0.0.0",
	"private": true,
	"description": "Converts shared tracks between Spotify and Anghami for iOS Shortcuts, running on Cloudflare Workers.",
	"license": "MIT",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"cf-typegen": "wrangler types",
		"typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p test"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"typescript": "^5.5.2",
		"vitest": "~4.1.0",
		"wrangler": "^4"
	}
}
